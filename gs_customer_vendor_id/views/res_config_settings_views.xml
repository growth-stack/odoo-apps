<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_codes" model="ir.ui.view">
        <field name="name">res.config.settings.form.gs.codes</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='fiscal_localization_setting_container']" position="after">
                <block title="Customer and Vendor IDs" name="gs_customer_vendor_id_container">
                    <setting string="Customer IDs" help="Prefix and next number for new customer IDs. Existing IDs don't change.">
                        <div class="row mt8">
                            <label for="gs_customer_prefix" string="Prefix" class="col-lg-4 o_light_label"/>
                            <field name="gs_customer_prefix" placeholder="CUS-"/>
                        </div>
                        <div class="row">
                            <label for="gs_customer_next" string="Next number" class="col-lg-4 o_light_label"/>
                            <field name="gs_customer_next"/>
                        </div>
                    </setting>
                    <setting string="Vendor IDs" help="Prefix and next number for new vendor IDs. Existing IDs don't change.">
                        <div class="row mt8">
                            <label for="gs_vendor_prefix" string="Prefix" class="col-lg-4 o_light_label"/>
                            <field name="gs_vendor_prefix" placeholder="VEN-"/>
                        </div>
                        <div class="row">
                            <label for="gs_vendor_next" string="Next number" class="col-lg-4 o_light_label"/>
                            <field name="gs_vendor_next"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
